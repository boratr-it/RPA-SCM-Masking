              <ui:InvokeCode ContinueOnError="{x:Null}" sap2010:Annotation.AnnotationText="무역종합현황판 컬럼추출, 폴더  생성" Code="' ===== 이름 정리 =====&#xA;Dim invalidChars As Char() = System.IO.Path.GetInvalidFileNameChars()&#xA;Dim clean As Func(Of String, String) =&#xA;    Function(s As String) As String&#xA;        Dim t As String = If(s, &quot;&quot;).Replace(&quot;*&quot;, &quot;x&quot;)&#xA;        For Each c As Char In invalidChars&#xA;            t = t.Replace(c, &quot;_&quot;c)&#xA;        Next&#xA;        Return t.Trim().TrimEnd(&quot;.&quot;c, &quot; &quot;c)&#xA;    End Function&#xA;&#xA;Dim norm As Func(Of String, String) =&#xA;    Function(s As String) If(s, &quot;&quot;).Replace(&quot;-&quot;, &quot;&quot;).Replace(&quot; &quot;, &quot;&quot;).Replace(&quot;_&quot;, &quot;&quot;).Trim().ToUpper()&#xA;&#xA;' ===== 브랜드 비교 (한글만 / 영문만 뽑아서 서로 포함되면 같은 브랜드) =====&#xA;Dim korOnly As Func(Of String, String) =&#xA;    Function(s As String) New String(If(s, &quot;&quot;).Where(Function(ch) ch &gt;= ChrW(&amp;HAC00) AndAlso ch &lt;= ChrW(&amp;HD7A3)).ToArray())&#xA;Dim engOnly As Func(Of String, String) =&#xA;    Function(s As String) New String(If(s, &quot;&quot;).ToLower().Where(Function(ch) ch &gt;= &quot;a&quot;c AndAlso ch &lt;= &quot;z&quot;c).ToArray())&#xA;&#xA;Dim sameBrand As Func(Of String, String, Boolean) =&#xA;    Function(a As String, b As String) As Boolean&#xA;        Dim ka As String = korOnly(a)&#xA;        Dim kb As String = korOnly(b)&#xA;        Dim ea As String = engOnly(a)&#xA;        Dim eb As String = engOnly(b)&#xA;        Dim korHit As Boolean = ka.Length &gt;= 2 AndAlso kb.Length &gt;= 2 AndAlso (ka.Contains(kb) OrElse kb.Contains(ka))&#xA;        Dim engHit As Boolean = ea.Length &gt;= 4 AndAlso eb.Length &gt;= 4 AndAlso (ea.Contains(eb) OrElse eb.Contains(ea))&#xA;        Return korHit OrElse engHit&#xA;    End Function&#xA;&#xA;' ===== 기존 브랜드 폴더 목록 =====&#xA;Dim brandDirs As New List(Of String)&#xA;If System.IO.Directory.Exists(rootPath) Then brandDirs.AddRange(System.IO.Directory.GetDirectories(rootPath))&#xA;Dim brandCache As New Dictionary(Of String, String())(StringComparer.OrdinalIgnoreCase)&#xA;&#xA;' 브랜드 폴더 찾기 → {경로, 상태}&#xA;Dim findBrand As Func(Of String, String()) =&#xA;    Function(brand As String) As String()&#xA;        If brandCache.ContainsKey(brand) Then Return brandCache(brand)&#xA;        Dim result As String()&#xA;        Dim exact As String = System.IO.Path.Combine(rootPath, clean(brand))&#xA;        If brandDirs.Any(Function(d) String.Equals(d, exact, StringComparison.OrdinalIgnoreCase)) Then&#xA;            result = {exact, &quot;기존(일치)&quot;}&#xA;        Else&#xA;            Dim cands As List(Of String) = brandDirs.Where(Function(d) sameBrand(brand, System.IO.Path.GetFileName(d))).ToList()&#xA;            If cands.Count = 1 Then&#xA;                result = {cands(0), &quot;기존(유사: &quot; &amp; System.IO.Path.GetFileName(cands(0)) &amp; &quot;)&quot;}&#xA;            ElseIf cands.Count &gt; 1 Then&#xA;                result = {&quot;&quot;, &quot;확인필요(후보: &quot; &amp; String.Join(&quot; / &quot;, cands.Select(Function(d) System.IO.Path.GetFileName(d))) &amp; &quot;)&quot;}&#xA;            Else&#xA;                result = {exact, &quot;신규생성&quot;}&#xA;            End If&#xA;        End If&#xA;        brandCache(brand) = result&#xA;        Return result&#xA;    End Function&#xA;&#xA;' ===== 품목 폴더 찾기 (품목번호 기준, 하이픈·공백·밑줄 무시, 2단계까지) =====&#xA;Dim isItemFolder As Func(Of String, String, Boolean) =&#xA;    Function(folderName As String, code As String) As Boolean&#xA;        Dim n As String = norm(folderName)&#xA;        Dim k As String = norm(code)&#xA;        If Not n.StartsWith(k) Then Return False&#xA;        Return n.Length = k.Length OrElse Not Char.IsDigit(n(k.Length))&#xA;    End Function&#xA;&#xA;Dim findItem As Func(Of String, String, String, String()) =&#xA;    Function(brandPath As String, code As String, name As String) As String()&#xA;        If System.IO.Directory.Exists(brandPath) Then&#xA;            Dim level1 As String() = System.IO.Directory.GetDirectories(brandPath)&#xA;            Dim hit As String = level1.FirstOrDefault(Function(d) isItemFolder(System.IO.Path.GetFileName(d), code))&#xA;            If hit Is Nothing Then&#xA;                hit = level1.SelectMany(Function(d) System.IO.Directory.GetDirectories(d)).FirstOrDefault(Function(d) isItemFolder(System.IO.Path.GetFileName(d), code))&#xA;            End If&#xA;            If hit IsNot Nothing Then Return {hit, &quot;기존&quot;}&#xA;        End If&#xA;        Return {System.IO.Path.Combine(brandPath, clean(code &amp; &quot; &quot; &amp; name)), &quot;신규생성&quot;}&#xA;    End Function&#xA;&#xA;' ===== 소비기한 폴더 찾기 (날짜 숫자만 비교: 2028.08.01 = 2028-08-01) → {경로, 상태} =====&#xA;Dim digitsOnly As Func(Of String, String) =&#xA;    Function(s As String) New String(If(s, &quot;&quot;).Where(Function(ch) Char.IsDigit(ch)).ToArray())&#xA;&#xA;Dim findExp As Func(Of String, List(Of String), String, String()) =&#xA;    Function(itemPath As String, ds As List(Of String), defaultName As String) As String()&#xA;        If ds.Count &gt; 0 AndAlso System.IO.Directory.Exists(itemPath) Then&#xA;            Dim key As String = String.Join(&quot;&quot;, ds.Select(Function(d) d.Replace(&quot;-&quot;, &quot;&quot;)))&#xA;            Dim hit As String = System.IO.Directory.GetDirectories(itemPath).FirstOrDefault(Function(d) digitsOnly(System.IO.Path.GetFileName(d)) = key)&#xA;            If hit IsNot Nothing Then Return {hit, &quot;기존&quot;}&#xA;        End If&#xA;        Return {System.IO.Path.Combine(itemPath, defaultName), &quot;신규생성&quot;}&#xA;    End Function&#xA;&#xA;' ===== 로그 =====&#xA;dtLog = New DataTable()&#xA;For Each colName As String In {&quot;브랜드&quot;, &quot;품목번호&quot;, &quot;통관번호&quot;, &quot;BL&quot;, &quot;브랜드폴더&quot;, &quot;품목폴더&quot;, &quot;소비기한폴더&quot;, &quot;저장경로&quot;}&#xA;    dtLog.Columns.Add(colName)&#xA;Next&#xA;&#xA;' ===== 행별 처리 (폴더만 생성, PDF 복사 없음) =====&#xA;For Each r As DataRow In dtTrade.Rows&#xA;    Dim brand As String = r(&quot;브랜드&quot;).ToString().Trim()&#xA;    Dim code As String = r(&quot;품목번호&quot;).ToString().Trim()&#xA;    Dim name As String = r(&quot;제품명&quot;).ToString().Trim()&#xA;    Dim customs As String = r(&quot;통관번호&quot;).ToString().Trim()&#xA;    Dim bl As String = r(&quot;B/L NO&quot;).ToString().Trim()&#xA;    Dim expiry As String = r(&quot;유통기한&quot;).ToString()&#xA;    If brand = &quot;&quot; OrElse code = &quot;&quot; Then Continue For&#xA;&#xA;    Try&#xA;        ' 브랜드 폴더&#xA;        Dim b As String() = findBrand(brand)&#xA;        If b(0) = &quot;&quot; Then&#xA;            dtLog.Rows.Add(brand, code, customs, bl, b(1), &quot;&quot;, &quot;&quot;, &quot;&quot;)&#xA;            Continue For&#xA;        End If&#xA;&#xA;        ' 품목 폴더&#xA;        Dim it As String() = findItem(b(0), code, name)&#xA;&#xA;        ' 소비기한 폴더&#xA;        Dim dates As New List(Of String)&#xA;        For Each m As System.Text.RegularExpressions.Match In System.Text.RegularExpressions.Regex.Matches(expiry, &quot;(\d{4})[/.\-](\d{1,2})[/.\-](\d{1,2})&quot;)&#xA;            Dim d As String = m.Groups(1).Value &amp; &quot;-&quot; &amp; m.Groups(2).Value.PadLeft(2, &quot;0&quot;c) &amp; &quot;-&quot; &amp; m.Groups(3).Value.PadLeft(2, &quot;0&quot;c)&#xA;            If Not dates.Contains(d) Then dates.Add(d)&#xA;        Next&#xA;        dates.Sort()&#xA;        Dim expFolder As String = If(dates.Count &gt; 0, &quot;소비기한 &quot; &amp; String.Join(&quot;, &quot;, dates), &quot;소비기한 미기재&quot;)&#xA;        Dim ex As String() = findExp(it(0), dates, expFolder)&#xA;&#xA;        ' 폴더 생성 (dryRun이면 만들지 않고 기록만)&#xA;        If Not dryRun Then&#xA;            System.IO.Directory.CreateDirectory(ex(0))&#xA;            If b(1) = &quot;신규생성&quot; AndAlso Not brandDirs.Contains(b(0)) Then brandDirs.Add(b(0))&#xA;        End If&#xA;&#xA;        dtLog.Rows.Add(brand, code, customs, bl, b(1), it(1), ex(1), ex(0))&#xA;&#xA;    Catch err As Exception&#xA;        dtLog.Rows.Add(brand, code, customs, bl, &quot;오류: &quot; &amp; err.Message, &quot;&quot;, &quot;&quot;, &quot;&quot;)&#xA;    End Try&#xA;Next" DisplayName="Invoke Code" sap:VirtualizedContainerService.HintSize="616,434" sap2010:WorkflowViewState.IdRef="InvokeCode_6">
