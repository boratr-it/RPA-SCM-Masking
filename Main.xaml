              <ui:InvokeCode ContinueOnError="{x:Null}" Code="' ===================== 표 만들기 도구 =====================&#xA;Dim enc As Func(Of String, String) = Function(s As String) System.Net.WebUtility.HtmlEncode(If(s, &quot;&quot;))&#xA;Dim thCell As Func(Of String, String) =&#xA;    Function(s As String) &quot;&lt;th style='background-color:#f2f2f2;border:1px solid #d9d9d9;padding:6px 10px;text-align:center;white-space:nowrap'&gt;&quot; &amp; enc(s) &amp; &quot;&lt;/th&gt;&quot;&#xA;Dim tdCell As Func(Of String, String, String) =&#xA;    Function(s As String, extra As String) &quot;&lt;td style='border:1px solid #d9d9d9;padding:6px 10px;text-align:center;&quot; &amp; extra &amp; &quot;'&gt;&quot; &amp; enc(s) &amp; &quot;&lt;/td&gt;&quot;&#xA;Dim tblOpen As String = &quot;&lt;table cellspacing='0' cellpadding='0' style='border-collapse:collapse;font-size:12px;margin:6px 0 4px 16px'&gt;&quot;&#xA;Dim folderOf As Func(Of String, String) =&#xA;    Function(p As String) If(p, &quot;&quot;).Replace(rootPath &amp; &quot;\&quot;, &quot;&quot;).Replace(&quot;\&quot;, &quot; &gt; &quot;)&#xA;Dim docName As Func(Of String, String) =&#xA;    Function(s As String) If(s = &quot;필증&quot;, &quot;수입신고필증&quot;, If(s = &quot;확인증&quot;, &quot;수입신고확인증&quot;, s))&#xA;&#xA;' ===================== 결과 문구를 쉬운 말로 =====================&#xA;Dim upLabel As Func(Of String, String) =&#xA;    Function(res As String) As String&#xA;        If res = &quot;업로드완료&quot; Then Return &quot;업로드 완료&quot;&#xA;        If res = &quot;업로드예정&quot; Then Return &quot;업로드 예정(테스트)&quot;&#xA;        If res.StartsWith(&quot;이미있음&quot;) OrElse res.Contains(&quot;already exists&quot;) Then Return &quot;이미 등록됨(중복)&quot;&#xA;        If res = &quot;업로드대기 파일없음&quot; Then Return &quot;파일없음&quot;&#xA;        If res.StartsWith(&quot;확인필요&quot;) Then Return &quot;확인 필요(확인증 후보 여러 개)&quot;&#xA;        If res = &quot;저장경로없음&quot; Then Return &quot;저장 폴더 없음&quot;&#xA;        Return &quot;오류(&quot; &amp; res.Replace(&quot;오류: &quot;, &quot;&quot;) &amp; &quot;)&quot;&#xA;    End Function&#xA;&#xA;Dim docLabel As Func(Of String, String) =&#xA;    Function(res As String) As String&#xA;        If res.StartsWith(&quot;완료&quot;) Then Return &quot;정상&quot;&#xA;        If res.StartsWith(&quot;마스킹본없음&quot;) Then Return &quot;파일없음&quot;&#xA;        If res.Contains(&quot;손상&quot;) Then Return &quot;파일 손상&quot;&#xA;        If res.StartsWith(&quot;[&quot;) Then Return &quot;확인 필요(확인증 후보 &quot; &amp; System.Text.RegularExpressions.Regex.Match(res, &quot;\[(\d+)건&quot;).Groups(1).Value &amp; &quot;건)&quot;&#xA;        If res.StartsWith(&quot;오류&quot;) Then Return &quot;오류&quot;&#xA;        Return res&#xA;    End Function&#xA;&#xA;Dim colorOf As Func(Of String, String) =&#xA;    Function(label As String) As String&#xA;        If label.StartsWith(&quot;업로드&quot;) OrElse label = &quot;정상&quot; Then Return &quot;color:#1a7f37;&quot;&#xA;        If label.StartsWith(&quot;이미&quot;) Then Return &quot;color:#666666;&quot;&#xA;        Return &quot;color:#c00000;font-weight:bold;&quot;&#xA;    End Function&#xA;&#xA;&#x9;' 결과 문구에서 파일명 추출 (&quot;완료: A.pdf / 완료: B.pdf&quot;)&#xA;Dim pickFiles As Func(Of String, List(Of String)) =&#xA;    Function(res As String) As List(Of String)&#xA;        Return System.Text.RegularExpressions.Regex.Matches(If(res, &quot;&quot;), &quot;완료:\s*(.+?\.pdf)&quot;).Cast(Of System.Text.RegularExpressions.Match)().Select(Function(m) m.Groups(1).Value.Trim()).ToList()&#xA;    End Function&#xA;&#xA;' 메일 첨부 목록 (처리 로그 + 분할건 서류)&#xA;Dim attach As New List(Of String) From {logPath}&#xA;&#x9;&#xA;' ===================== 건수 =====================&#xA;Dim allRows As List(Of DataRow) = dtUpload.AsEnumerable().ToList()&#xA;Dim upRows As List(Of DataRow) = allRows.Where(Function(r) r(&quot;결과&quot;).ToString() = &quot;업로드완료&quot; OrElse r(&quot;결과&quot;).ToString() = &quot;업로드예정&quot;).ToList()&#xA;Dim dupRows As List(Of DataRow) = allRows.Where(Function(r) r(&quot;결과&quot;).ToString().StartsWith(&quot;이미있음&quot;) OrElse r(&quot;결과&quot;).ToString().Contains(&quot;already exists&quot;)).ToList()&#xA;Dim errRows As List(Of DataRow) = allRows.Where(Function(r) Not upRows.Contains(r) AndAlso Not dupRows.Contains(r) AndAlso Not r(&quot;결과&quot;).ToString().StartsWith(&quot;확인필요&quot;)).ToList()&#xA;Dim missCnt As Integer = dtMissing.Rows.Count&#xA;&#xA;' ===================== 본문 =====================&#xA;Dim sb As New System.Text.StringBuilder()&#xA;sb.Append(&quot;&lt;div style='font-family:Malgun Gothic,sans-serif;font-size:13px;color:#222222'&gt;&quot;)&#xA;sb.Append(&quot;&lt;p&gt;안녕하세요.&lt;br&gt;&quot; &amp; Today.ToString(&quot;yyyy-MM-dd&quot;) &amp; &quot; 수입신고필증·수입신고확인증을 마스킹하여 공용 드라이브(수입서류) 품목별 폴더에 업로드한 결과를 안내드립니다.&quot;)&#xA;If dryRun Then sb.Append(&quot; &lt;b style='color:#c00000'&gt;[테스트 실행 - 실제로 업로드되지 않음]&lt;/b&gt;&quot;)&#xA;sb.Append(&quot;&lt;/p&gt;&quot;)&#xA;&#xA;' --- 처리 요약 ---&#xA;sb.Append(&quot;&lt;p style='margin-top:18px'&gt;&lt;b&gt;■ 처리 요약&lt;/b&gt;&lt;/p&gt;&quot;)&#xA;sb.Append(tblOpen &amp; &quot;&lt;tr&gt;&quot; &amp; thCell(&quot;구분&quot;) &amp; thCell(&quot;건수&quot;) &amp; thCell(&quot;설명&quot;) &amp; &quot;&lt;/tr&gt;&quot;)&#xA;sb.Append(&quot;&lt;tr&gt;&quot; &amp; tdCell(&quot;신규 업로드&quot;, &quot;&quot;) &amp; tdCell(upRows.Count.ToString() &amp; &quot;건&quot;, &quot;color:#1a7f37;font-weight:bold;&quot;) &amp; tdCell(&quot;공용 드라이브에 새로 올린 서류&quot;, &quot;&quot;) &amp; &quot;&lt;/tr&gt;&quot;)&#xA;sb.Append(&quot;&lt;tr&gt;&quot; &amp; tdCell(&quot;이미 등록됨(중복)&quot;, &quot;&quot;) &amp; tdCell(dupRows.Count.ToString() &amp; &quot;건&quot;, &quot;&quot;) &amp; tdCell(&quot;같은 서류가 이미 폴더에 있어 올리지 않음&quot;, &quot;&quot;) &amp; &quot;&lt;/tr&gt;&quot;)&#xA;sb.Append(&quot;&lt;tr&gt;&quot; &amp; tdCell(&quot;확인 필요&quot;, &quot;&quot;) &amp; tdCell(missCnt.ToString() &amp; &quot;건&quot;, If(missCnt &gt; 0, &quot;color:#c00000;font-weight:bold;&quot;, &quot;&quot;)) &amp; tdCell(&quot;파일이 없거나 확인증 선택이 필요한 품목&quot;, &quot;&quot;) &amp; &quot;&lt;/tr&gt;&quot;)&#xA;sb.Append(&quot;&lt;tr&gt;&quot; &amp; tdCell(&quot;업로드 오류&quot;, &quot;&quot;) &amp; tdCell(errRows.Count.ToString() &amp; &quot;건&quot;, If(errRows.Count &gt; 0, &quot;color:#c00000;font-weight:bold;&quot;, &quot;&quot;)) &amp; tdCell(&quot;업로드 중 문제가 생긴 서류&quot;, &quot;&quot;) &amp; &quot;&lt;/tr&gt;&quot;)&#xA;sb.Append(&quot;&lt;/table&gt;&quot;)&#xA;&#xA;' --- 1. 신규 업로드 내역 ---&#xA;sb.Append(&quot;&lt;p style='margin-top:22px'&gt;&lt;b&gt;■ 1. 신규 업로드 내역&lt;/b&gt;&lt;/p&gt;&quot;)&#xA;If upRows.Count &gt; 0 Then&#xA;    sb.Append(tblOpen &amp; &quot;&lt;tr&gt;&quot; &amp; thCell(&quot;품목번호&quot;) &amp; thCell(&quot;서류&quot;) &amp; thCell(&quot;파일명&quot;) &amp; thCell(&quot;저장 위치 (브랜드 &gt; 품목 &gt; 소비기한)&quot;) &amp; &quot;&lt;/tr&gt;&quot;)&#xA;    For Each r As DataRow In upRows&#xA;        sb.Append(&quot;&lt;tr&gt;&quot; &amp; tdCell(r(&quot;품목번호&quot;).ToString(), &quot;&quot;) &amp; tdCell(docName(r(&quot;서류&quot;).ToString()), &quot;&quot;) &amp; tdCell(r(&quot;파일&quot;).ToString(), &quot;&quot;) &amp; tdCell(folderOf(r(&quot;저장경로&quot;).ToString()), &quot;&quot;) &amp; &quot;&lt;/tr&gt;&quot;)&#xA;    Next&#xA;    sb.Append(&quot;&lt;/table&gt;&quot;)&#xA;Else&#xA;    sb.Append(&quot;&lt;p style='margin-left:16px'&gt;새로 업로드된 서류가 없습니다.&lt;/p&gt;&quot;)&#xA;End If&#xA;&#xA;' --- 2. 확인이 필요한 품목 ---&#xA;sb.Append(&quot;&lt;p style='margin-top:22px'&gt;&lt;b&gt;■ 2. 확인이 필요한 품목&lt;/b&gt;&lt;/p&gt;&quot;)&#xA;If missCnt &gt; 0 OrElse errRows.Count &gt; 0 Then&#xA;    sb.Append(tblOpen &amp; &quot;&lt;tr&gt;&quot; &amp; thCell(&quot;품목번호&quot;) &amp; thCell(&quot;통관번호&quot;) &amp; thCell(&quot;B/L&quot;) &amp; thCell(&quot;수입신고필증&quot;) &amp; thCell(&quot;수입신고확인증&quot;) &amp; thCell(&quot;조치 방법&quot;) &amp; &quot;&lt;/tr&gt;&quot;)&#xA;    For Each r As DataRow In dtMissing.Rows&#xA;        Dim pl As String = docLabel(r(&quot;필증_결과&quot;).ToString())&#xA;        Dim cl As String = docLabel(r(&quot;확인증_결과&quot;).ToString())&#xA;        Dim acts As New List(Of String)&#xA;        If pl.StartsWith(&quot;파일&quot;) Then acts.Add(&quot;필증 마스킹 후 다시 실행&quot;)&#xA;        If cl.StartsWith(&quot;파일&quot;) Then acts.Add(&quot;확인증 마스킹 후 다시 실행&quot;)&#xA;        If cl.StartsWith(&quot;확인 필요&quot;) Then&#xA;            acts.Add(&quot;분할건 확인 필요&quot;)&#xA;            ' 필증 + 확인증 후보 파일을 메일에 첨부&#xA;            For Each fn As String In pickFiles(r(&quot;필증_결과&quot;).ToString()).Concat(pickFiles(r(&quot;확인증_결과&quot;).ToString()))&#xA;                Dim p As String = System.IO.Path.Combine(renameFolder, fn)&#xA;                If System.IO.File.Exists(p) AndAlso Not attach.Contains(p) Then attach.Add(p)&#xA;            Next&#xA;        End If&#xA;        sb.Append(&quot;&lt;tr&gt;&quot; &amp; tdCell(r(&quot;품목번호&quot;).ToString(), &quot;&quot;) &amp; tdCell(r(&quot;통관번호&quot;).ToString(), &quot;&quot;) &amp; tdCell(r(&quot;BL&quot;).ToString(), &quot;&quot;) &amp; tdCell(pl, colorOf(pl)) &amp; tdCell(cl, colorOf(cl)) &amp; tdCell(String.Join(&quot;, &quot;, acts), &quot;&quot;) &amp; &quot;&lt;/tr&gt;&quot;)&#xA;    Next&#xA;    For Each r As DataRow In errRows&#xA;        Dim lb As String = upLabel(r(&quot;결과&quot;).ToString())&#xA;        Dim isPil As Boolean = r(&quot;서류&quot;).ToString() = &quot;필증&quot;&#xA;        sb.Append(&quot;&lt;tr&gt;&quot; &amp; tdCell(r(&quot;품목번호&quot;).ToString(), &quot;&quot;) &amp; tdCell(r(&quot;통관번호&quot;).ToString(), &quot;&quot;) &amp; tdCell(&quot;-&quot;, &quot;&quot;) &amp; tdCell(If(isPil, lb, &quot;-&quot;), If(isPil, colorOf(lb), &quot;&quot;)) &amp; tdCell(If(isPil, &quot;-&quot;, lb), If(isPil, &quot;&quot;, colorOf(lb))) &amp; tdCell(&quot;업로드 다시 확인&quot;, &quot;&quot;) &amp; &quot;&lt;/tr&gt;&quot;)&#xA;    Next&#xA;    sb.Append(&quot;&lt;/table&gt;&quot;)&#xA;    sb.Append(&quot;&lt;p style='color:#666666;margin-left:16px;font-size:12px'&gt;※ 파일없음: 마스킹된 파일이 없어 업로드하지 않음&lt;br&gt;※ 분할건 확인 필요: 같은 B/L에 확인증이 여러 개(분할 통관)라 품목에 맞는 파일 확인이 필요하며, 해당 품목의 수입신고필증과 확인증 후보 파일을 메일에 첨부했습니다.&lt;/p&gt;&quot;)&#xA;Else&#xA;    sb.Append(&quot;&lt;p style='margin-left:16px'&gt;확인이 필요한 품목이 없습니다.&lt;/p&gt;&quot;)&#xA;End If&#xA;&#xA;' --- 3. 이미 등록되어 건너뛴 서류 ---&#xA;If dupRows.Count &gt; 0 Then&#xA;    sb.Append(&quot;&lt;p style='margin-top:22px'&gt;&lt;b&gt;■ 3. 이미 등록되어 건너뛴 서류&lt;/b&gt;&lt;/p&gt;&quot;)&#xA;    sb.Append(tblOpen &amp; &quot;&lt;tr&gt;&quot; &amp; thCell(&quot;품목번호&quot;) &amp; thCell(&quot;서류&quot;) &amp; thCell(&quot;결과&quot;) &amp; &quot;&lt;/tr&gt;&quot;)&#xA;    For Each r As DataRow In dupRows&#xA;        sb.Append(&quot;&lt;tr&gt;&quot; &amp; tdCell(r(&quot;품목번호&quot;).ToString(), &quot;&quot;) &amp; tdCell(docName(r(&quot;서류&quot;).ToString()), &quot;&quot;) &amp; tdCell(&quot;이미 등록됨(중복)&quot;, &quot;color:#666666;&quot;) &amp; &quot;&lt;/tr&gt;&quot;)&#xA;    Next&#xA;    sb.Append(&quot;&lt;/table&gt;&quot;)&#xA;End If&#xA;&#xA;' --- 첨부 안내 ---&#xA;sb.Append(&quot;&lt;p style='margin-top:22px;color:#666666;font-size:12px'&gt;※ 첨부한 처리 로그(&quot; &amp; enc(System.IO.Path.GetFileName(logPath)) &amp; &quot;)에서 '업로드' 시트는 전체 업로드 결과, '미처리' 시트는 확인이 필요한 품목을 보여줍니다.&lt;/p&gt;&quot;)&#xA;sb.Append(&quot;&lt;/div&gt;&quot;)&#xA;&#xA;mailBody = sb.ToString()&#xA;mailSubject = &quot;[RPA] 알림] 수입서류 마스킹 및 드라이브 자동업로드 &amp; Today.ToString(&quot;yyyy-MM-dd&quot;) &amp; &quot; 결과 - 신규 &quot; &amp; upRows.Count.ToString() &amp; &quot;건 / 확인 필요 &quot; &amp; missCnt.ToString() &amp; &quot;건&quot; &amp; If(dryRun, &quot; [테스트]&quot;, &quot;&quot;)&#xA;mailAttachments = attach.ToArray()" DisplayName="Invoke Code" sap:VirtualizedContainerService.HintSize="616,403" sap2010:WorkflowViewState.IdRef="InvokeCode_8">
