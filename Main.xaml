              <ui:InvokeCode ContinueOnError="{x:Null}" sap2010:Annotation.AnnotationText="invoke code D" Code="' 품목번호|통관번호 → 공용 드라이브 저장경로&#xA;Dim pathMap As New Dictionary(Of String, String)(StringComparer.OrdinalIgnoreCase)&#xA;For Each r As DataRow In dtLog.Rows&#xA;    Dim key As String = r(&quot;품목번호&quot;).ToString().Trim() &amp; &quot;|&quot; &amp; r(&quot;통관번호&quot;).ToString().Trim()&#xA;    Dim p As String = r(&quot;저장경로&quot;).ToString().Trim()&#xA;    If p &lt;&gt; &quot;&quot; AndAlso Not pathMap.ContainsKey(key) Then pathMap(key) = p&#xA;Next&#xA;&#xA;' &quot;완료: 파일명.pdf / 완료: 파일명.pdf&quot; 에서 파일명만 추출&#xA;Dim pickFiles As Func(Of String, List(Of String)) =&#xA;    Function(res As String) As List(Of String)&#xA;        Return System.Text.RegularExpressions.Regex.Matches(If(res, &quot;&quot;), &quot;완료:\s*(.+?\.pdf)&quot;).Cast(Of System.Text.RegularExpressions.Match)().Select(Function(m) m.Groups(1).Value.Trim()).ToList()&#xA;    End Function&#xA;&#xA;' 폴더에 같은 종류의 서류가 이미 있는지 (있으면 그 파일 이름, 없으면 Nothing)&#xA;Dim findExisting As Func(Of String, String, String) =&#xA;    Function(folder As String, docType As String) As String&#xA;        If Not System.IO.Directory.Exists(folder) Then Return Nothing&#xA;        Return System.IO.Directory.GetFiles(folder).Select(Function(f) System.IO.Path.GetFileName(f)).FirstOrDefault(Function(n)&#xA;            Dim t As String = n.Replace(&quot; &quot;, &quot;&quot;)&#xA;            If docType = &quot;필증&quot; Then Return t.Contains(&quot;필증&quot;)&#xA;            Return t.Contains(&quot;확인증&quot;) OrElse t.Contains(&quot;확인서&quot;)&#xA;        End Function)&#xA;    End Function&#xA;&#xA;dtUpload = New DataTable()&#xA;For Each colName As String In {&quot;품목번호&quot;, &quot;통관번호&quot;, &quot;서류&quot;, &quot;파일&quot;, &quot;저장경로&quot;, &quot;결과&quot;}&#xA;    dtUpload.Columns.Add(colName)&#xA;Next&#xA;&#xA;Dim done As New HashSet(Of String)(StringComparer.OrdinalIgnoreCase)&#xA;&#xA;For Each r As DataRow In dtRename.Rows&#xA;    Dim code As String = r(&quot;품목번호&quot;).ToString().Trim()&#xA;    Dim customs As String = r(&quot;통관번호&quot;).ToString().Trim()&#xA;    Dim key As String = code &amp; &quot;|&quot; &amp; customs&#xA;&#xA;    If Not pathMap.ContainsKey(key) Then&#xA;        dtUpload.Rows.Add(code, customs, &quot;&quot;, &quot;&quot;, &quot;&quot;, &quot;저장경로없음&quot;)&#xA;        Continue For&#xA;    End If&#xA;    Dim dest As String = pathMap(key)&#xA;&#xA;    ' 업로드할 파일 목록 (확인증이 확인필요면 제외)&#xA;    Dim jobs As New List(Of String())&#xA;    For Each fn As String In pickFiles(r(&quot;필증_결과&quot;).ToString())&#xA;        jobs.Add({&quot;필증&quot;, fn})&#xA;    Next&#xA;    Dim confRes As String = r(&quot;확인증_결과&quot;).ToString()&#xA;    If confRes.StartsWith(&quot;[&quot;) Then&#xA;        dtUpload.Rows.Add(code, customs, &quot;확인증&quot;, &quot;&quot;, dest, &quot;확인필요(업로드 안 함)&quot;)&#xA;    Else&#xA;        For Each fn As String In pickFiles(confRes)&#xA;            jobs.Add({&quot;확인증&quot;, fn})&#xA;        Next&#xA;    End If&#xA;&#xA;    For Each job As String() In jobs&#xA;        Dim src As String = System.IO.Path.Combine(renameFolder, job(1))&#xA;        Dim target As String = System.IO.Path.Combine(dest, job(1))&#xA;        Try&#xA;            If done.Contains(dest &amp; &quot;|&quot; &amp; job(0)) Then Continue For&#xA;&#xA;            ' 이미 같은 종류의 서류가 폴더에 있으면 건너뜀&#xA;            Dim existing As String = findExisting(dest, job(0))&#xA;&#x9;&#x9;&#x9;If existing Is Nothing AndAlso System.IO.File.Exists(target) Then existing = job(1)&#xA;            If existing IsNot Nothing Then&#xA;                dtUpload.Rows.Add(code, customs, job(0), job(1), dest, &quot;이미있음(건너뜀): &quot; &amp; existing)&#xA;                done.Add(dest &amp; &quot;|&quot; &amp; job(0))&#xA;                Continue For&#xA;            End If&#xA;&#xA;            If Not System.IO.File.Exists(src) Then&#xA;                dtUpload.Rows.Add(code, customs, job(0), job(1), dest, &quot;업로드대기 파일없음&quot;)&#xA;                Continue For&#xA;            End If&#xA;&#xA;            If dryRun Then&#xA;                dtUpload.Rows.Add(code, customs, job(0), job(1), dest, &quot;업로드예정&quot;)&#xA;            Else&#xA;                System.IO.Directory.CreateDirectory(dest)&#xA;                System.IO.File.Copy(src, target, False)&#xA;                dtUpload.Rows.Add(code, customs, job(0), job(1), dest, &quot;업로드완료&quot;)&#xA;            End If&#xA;            done.Add(dest &amp; &quot;|&quot; &amp; job(0))&#xA;        Catch ex As Exception&#xA;            dtUpload.Rows.Add(code, customs, job(0), job(1), dest, &quot;오류: &quot; &amp; ex.Message)&#xA;        End Try&#xA;    Next&#xA;Next" DisplayName="Invoke Code" sap:VirtualizedContainerService.HintSize="616,434" sap2010:WorkflowViewState.IdRef="InvokeCode_7">
